{
  "info": {
    "name": "Jaiphat – Vitrine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lance d'abord `php artisan db:seed --class=ShowcaseSeeder`. Aucun environnement requis."
  },
  "item": [
    {
      "name": "Accueil complet (fr)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/home?lang=fr",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "",
              "const d = pm.response.json().data;",
              "pm.test(\"Toutes les sections sont là\", () => [\"hero\",\"stats\",\"band\",\"services\",\"featured_products\",\"testimonials\",\"brides\"].forEach(k => pm.expect(d).to.have.property(k)));",
              "pm.test(\"Le hero a un titre\", () => pm.expect(d.hero.title).to.be.a(\"string\").that.is.not.empty);",
              "pm.test(\"Les stats sont des nombres\", () => { pm.expect(d.stats.brides).to.be.a(\"number\"); pm.expect(d.stats.rating).to.be.a(\"number\"); });",
              "pm.test(\"Les produits vedettes sont limités à 4\", () => pm.expect(d.featured_products.length).to.be.at.most(4));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Accueil en anglais",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/home?lang=en",
        "description": "Suppose les données du ShowcaseSeeder."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Titre en anglais\", () => pm.expect(pm.response.json().data.hero.title).to.eql(\"The day everything begins\"));"
            ]
          }
        }
      ],
      "response": []
    },
